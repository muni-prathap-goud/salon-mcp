# Copy to .env and fill in. Never commit .env.

# Which salon system to talk to: mock (default) or setmore
SALON_BACKEND=mock

# Optional. Where the mock salon saves bookings so they survive a restart.
SALON_STATE_FILE=state.json

# Apple iCloud calendar (CalDAV). App-specific password from appleid.apple.com.
APPLE_ID=
APPLE_APP_PASSWORD=

# Google Calendar. Paths to the OAuth desktop credentials and the cached token.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Setmore. Only needed once the salon grants API access and SALON_BACKEND=setmore.
SETMORE_REFRESH_TOKEN=
